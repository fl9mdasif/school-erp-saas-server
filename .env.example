NODE_ENV=development
PORT=5000
# MongoDB must be a replica set (transactions). Atlas works; local needs a single-node replset.
DATABASE_URL=mongodb://127.0.0.1:27017/school_management?replicaSet=rs0

JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-another-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform owner seed
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASS=change-me-strong-password

# Placeholders, never hard code the product name or domain
PLATFORM_NAME=xyz
PLATFORM_DOMAIN=xyz.com
RESERVED_SLUGS=
CORS_ORIGINS=http://localhost:3000

# Image uploads: the browser uploads straight to Cloudinary (free plan is enough). The API only signs the request.
# Set UPLOAD_PROVIDER=cloudinary and fill the three values from the Cloudinary dashboard. API secret stays on the server only.
UPLOAD_PROVIDER=mock
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

